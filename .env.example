# Google Sheets Configuration
# Path to service account JSON key file OR raw JSON string in GOOGLE_SERVICE_ACCOUNT_JSON
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Target Google Sheet ID (from URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
SPREADSHEET_ID=your_spreadsheet_id_here
SHEET_AUDIT_TAB="Tab Audit"
SHEET_MASTER_TAB="Master Data Lomba"

# Scraper Settings
MAX_ITEMS_PER_RUN=25
MAX_PAGES=5
MIN_DELAY_SECONDS=2.0
MAX_DELAY_SECONDS=4.0
